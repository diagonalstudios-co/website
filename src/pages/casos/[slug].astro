---
import { getCollection, render } from "astro:content";
import CaseLayout from "@layouts/CaseLayout.astro";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((caseEntry) => ({
    params: { slug: caseEntry.id.replace(/\.md$/, "") },
    props: { caseEntry },
  }));
}

const { caseEntry } = Astro.props;
const { Content } = await render(caseEntry);
const { client, kind, metric, metricLabel, description, quote, quoteAuthor, quoteRole } = caseEntry.data;

const seoTitles: Record<string, string> = {
  elix: "ELIX — Caso de éxito: catálogo digital | Diagonal Studios",
  antifuga: "Antifuga — Caso de éxito: SaaS de gestión | Diagonal Studios",
};
const slug = caseEntry.id.replace(/\.md$/, "");
const seoTitle = seoTitles[slug] ?? `${client} — Caso de éxito | Diagonal Studios`;
---

<CaseLayout
  title={seoTitle}
  description={description}
  client={client}
  kind={kind}
  metric={metric}
  metricLabel={metricLabel}
  quote={quote}
  quoteAuthor={quoteAuthor}
  quoteRole={quoteRole}
>
  <Content />
</CaseLayout>
