---
const stories = [
  {
    number: "01",
    category: "Fintech · Web + API",
    title: "Atlas·Pay",
    metric: "+40%",
    metricDescription: "conversión de checkout",
    image: "/projects/atlas-pay.jpg",
  },
  {
    number: "02",
    category: "SaaS · Plataforma B2B",
    title: "Kuiper",
    metric: "8 sem",
    metricDescription: "de idea a MVP en producción",
    image: "/projects/kuiper.jpg",
  },
  {
    number: "03",
    category: "Salud · App + Cloud",
    title: "Meridian",
    metric: "99.98%",
    metricDescription: "uptime en el primer año",
    image: "/projects/meridian.jpg",
  },
];
---
<section id="proyectos" class="py-32 border-t border-[#e6e6e6]">
  <div class="max-w-[1400px] mx-auto px-10">
    <div class="flex items-end justify-between">
      <div>
        <p class="font-mono text-xs tracking-[2.16px] uppercase text-[#666]">— Resultados</p>
        <h2 class="font-archivo font-black text-[96px] leading-[96px] uppercase mt-4">Casos de éxito</h2>
      </div>
      <a href="#" class="font-mono text-xs tracking-[2.16px] uppercase text-black hover:opacity-70 transition-opacity">
        Ver todos los casos →
      </a>
    </div>
    <div class="grid grid-cols-3 gap-px bg-[#e6e6e6] mt-16">
      {stories.map((story) => (
        <article class="bg-white p-6 group">
          <div class="bg-[#e6e6e6] h-[293px] relative overflow-hidden mb-6">
            <div class="absolute inset-0 bg-gradient-to-br from-zinc-200 to-zinc-300"></div>
            <div class="absolute top-0 left-0 bg-black px-3 py-1">
              <span class="font-mono text-[10px] tracking-[1.8px] uppercase text-white">{story.number}</span>
            </div>
          </div>
          <p class="font-mono text-xs tracking-[2.16px] uppercase text-[#666]">{story.category}</p>
          <h3 class="font-archivo font-extrabold text-[24px] leading-[32px] uppercase mt-1">{story.title}</h3>
          <div class="border-t border-[#e6e6e6] mt-6 pt-5">
            <p class="font-archivo font-black text-[48px] leading-[48px]">{story.metric}</p>
            <p class="font-inter text-sm text-[#666] mt-2">{story.metricDescription}</p>
          </div>
          <a href="#" class="inline-flex items-center gap-2 mt-6 font-mono text-xs tracking-[2.16px] uppercase text-black hover:opacity-70 transition-opacity">
            Ver caso completo →
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
