---
import { Image } from "astro:assets";
import elixImg from "./images/Elix.png";
import antifugaImg from "./images/Antifuga.png";

const CASES = [
  {
    slug: "elix",
    client: "ELIX",
    kind: "Web · Catálogo digital",
    metric: "+40%",
    metricTarget: "40",
    metricPrefix: "+",
    metricSuffix: "%",
    metricDecimals: "0",
    metricLabel: "consultas recibidas",
    img: elixImg,
    alt: "Mockup del catálogo digital de ELIX en laptop y celular",
  },
  {
    slug: "antifuga",
    client: "Antifuga",
    kind: "SaaS · Plataforma de gestión financiera",
    metric: "8 semanas",
    metricTarget: "8",
    metricPrefix: "",
    metricSuffix: " semanas",
    metricDecimals: "0",
    metricLabel: "de la idea a un SaaS funcional",
    img: antifugaImg,
    alt: "Dashboard de Antifuga mostrado en una tablet",
  },
];
---
<section id="casos" class="border-t border-g-200 bg-paper py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="reveal mb-16">
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-g-500">— Resultados</p>
      <h2 class="font-display text-4xl font-black uppercase leading-none md:text-6xl lg:text-8xl" style="font-stretch: 75%">
        Casos de éxito
      </h2>
    </div>

    <div class="grid gap-px bg-g-200 md:grid-cols-2 lg:grid-cols-3">
      {CASES.map((c, i) => (
        <article
          class="reveal group flex flex-col bg-paper p-6 transition-colors duration-300 hover:bg-g-100"
          style={`animation-delay: ${i * 0.1}s`}
        >
          <div class="relative mb-6 aspect-[4/3] overflow-hidden bg-paper">
            <Image
              src={c.img}
              alt={c.alt}
              format="webp"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute left-0 top-0 bg-ink px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-paper">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>

          <p class="font-mono text-xs uppercase tracking-[0.18em] text-g-500">{c.kind}</p>
          <h3 class="mt-1 font-display text-xl font-extrabold uppercase md:text-2xl" style="font-stretch: 75%">
            {c.client}
          </h3>

          <div class="mt-6 border-t border-g-200 pt-5">
            <p
              class="counter-value font-display text-4xl font-black leading-none md:text-5xl"
              style="font-stretch: 75%"
              data-prefix={c.metricPrefix}
              data-target={c.metricTarget}
              data-suffix={c.metricSuffix}
              data-decimals={c.metricDecimals}
            >
              {c.metric}
            </p>
            <p class="mt-2 text-sm text-g-500">{c.metricLabel}</p>
          </div>

          <a
            href={`/casos/${c.slug}`}
            class="group/link mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em]"
          >
            Ver caso completo
            <span class="transition-transform group-hover/link:translate-x-1">→</span>
          </a>
        </article>
      ))}
      <div class="hidden bg-paper lg:block" aria-hidden="true"></div>
    </div>
  </div>
</section>
