---
const CASES = [
  {
    slug: "elix",
    client: "Elix Fragancias",
    kind: "E-commerce",
    metric: "+40%",
    metricTarget: "40",
    metricPrefix: "+",
    metricSuffix: "%",
    metricDecimals: "0",
    metricLabel: "conversión de checkout",
    img: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080",
  },
  {
    slug: "kuiper",
    client: "Kuiper",
    kind: "SaaS · Plataforma B2B",
    metric: "8 sem",
    metricTarget: "8",
    metricPrefix: "",
    metricSuffix: " sem",
    metricDecimals: "0",
    metricLabel: "de idea a MVP en producción",
    img: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080",
  },
  {
    slug: "meridian",
    client: "Meridian",
    kind: "Salud · App + Cloud",
    metric: "99.98%",
    metricTarget: "99.98",
    metricPrefix: "",
    metricSuffix: "%",
    metricDecimals: "2",
    metricLabel: "uptime en el primer año",
    img: "https://images.unsplash.com/photo-1597672996375-4d21cad0cbb9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080",
  },
];
---
<section id="casos" class="border-t border-g-200 bg-paper py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="reveal mb-16 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-g-500">— Resultados</p>
        <h2 class="font-display text-4xl font-black uppercase leading-none md:text-6xl lg:text-8xl" style="font-stretch: 75%">
          Casos de éxito
        </h2>
      </div>
      <a href="#casos" class="group font-mono text-xs uppercase tracking-[0.18em]">
        Ver todos los casos
        <span class="ml-2 inline-block transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid gap-px bg-g-200 md:grid-cols-2 lg:grid-cols-3">
      {CASES.map((c, i) => (
        <article
          class="reveal group flex flex-col bg-paper p-6 transition-colors duration-300 hover:bg-g-100"
          style={`animation-delay: ${i * 0.1}s`}
        >
          <div class="relative mb-6 aspect-[4/3] overflow-hidden bg-g-200">
            <img
              src={c.img}
              alt={`Mockup del proyecto de ${c.client}`}
              loading="lazy"
              class="h-full w-full object-cover grayscale contrast-125 transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute left-0 top-0 bg-ink px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-paper">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>

          <p class="font-mono text-xs uppercase tracking-[0.18em] text-g-500">{c.kind}</p>
          <h3 class="mt-1 font-display text-xl font-extrabold uppercase md:text-2xl" style="font-stretch: 75%">
            {c.client}
          </h3>

          <div class="mt-6 border-t border-g-200 pt-5">
            <p
              class="counter-value font-display text-4xl font-black leading-none md:text-5xl"
              style="font-stretch: 75%"
              data-prefix={c.metricPrefix}
              data-target={c.metricTarget}
              data-suffix={c.metricSuffix}
              data-decimals={c.metricDecimals}
            >
              {c.metric}
            </p>
            <p class="mt-2 text-sm text-g-500">{c.metricLabel}</p>
          </div>

          <a
            href={`/casos/${c.slug}`}
            class="group/link mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em]"
          >
            Ver caso completo
            <span class="transition-transform group-hover/link:translate-x-1">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
