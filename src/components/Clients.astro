---
import { Image } from "astro:assets";
import elixLogo from "./images/ELIX Logo.png";
import antifugaLogo from "./images/Antifuga Logo.png";

const CLIENTS = [
  { src: elixLogo, alt: "Logo de ELIX" },
  { src: antifugaLogo, alt: "Logo de Antifuga" },
];
---
<section class="border-b border-g-200 bg-paper py-16 md:py-20">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="reveal grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-g-500">— Confianza</p>
        <h2 class="font-display text-3xl font-extrabold uppercase leading-none md:text-4xl lg:text-5xl" style="font-stretch: 75%">
          Marcas que confían<br />en nosotros
        </h2>
      </div>
{/*
      <p
        class="counter-value font-display text-4xl font-black leading-none md:text-5xl lg:text-7xl"
        style="font-stretch: 75%"
        data-prefix="+"
        data-target="30"
        data-suffix=""
        data-decimals="0"
      >
        +30
        <span class="ml-3 align-middle font-body text-sm font-medium text-g-500">marcas y contando</span>
      </p>
*/}
    </div>
  </div>

  <div class="marquee relative mt-14 overflow-hidden border-y border-g-200 py-6">
    <div class="flex items-center justify-center gap-12 px-8 md:gap-16">
      {CLIENTS.map((logo) => (
        <Image
          src={logo.src}
          alt={logo.alt}
          format="webp"
          loading="lazy"
          class="h-auto max-h-11 max-w-40 opacity-50 md:max-h-14 md:max-w-48"
        />
      ))}
    </div>
  </div>
</section>
