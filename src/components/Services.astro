---
const SERVICES = [
  { name: "UX / UI Design", tags: "Research · Experiencia de usuario · Prototipado · Sistemas de diseño" },
  { name: "Frontend", tags: "Experiencias digitales · Interfaces adaptables · Interacción · Accesibilidad" },
  { name: "Backend", tags: "Lógica de negocio · Arquitectura de sistemas · Datos · Integraciones" },
  { name: "Cloud / DevOps", tags: "Infraestructura cloud · Automatización · Despliegue continuo · Observabilidad" },
  { name: "QA", tags: "Testing automatizado · Pruebas funcionales · Calidad de software · Performance" },
  { name: "Soporte & Evolución", tags: "Monitoreo · Mantenimiento · Iteración continua · Mejora del producto" },
];
---
<section id="servicios" class="bg-ink text-paper py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="mb-16 grid gap-10 md:grid-cols-[1fr_1fr]">
      <div class="reveal">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-paper/50">— Servicios</p>
        <h2 class="font-display text-3xl font-black uppercase leading-none md:text-4xl lg:text-6xl" style="font-stretch: 75%">
          Un equipo,<br />todo el ciclo
        </h2>
      </div>
      <p class="reveal self-end text-base leading-relaxed text-paper/60 md:text-lg" style="animation-delay: 0.1s">
        Desde la primera idea hasta la puesta en producción, cada parte del producto se construye bajo una misma visión. Diseño, desarrollo e infraestructura trabajan en conjunto para crear soluciones coherentes, cuidadas y hechas a medida.
      </p>
    </div>

    <div class="border-t border-paper/15">
      {SERVICES.map((s, i) => (
        <div
          class="reveal group grid grid-cols-[auto_1fr_auto] items-center gap-4 border-b border-paper/15 py-5 transition-colors duration-300 hover:bg-paper hover:text-ink md:gap-6 md:py-8"
          style={`animation-delay: ${i * 0.06}s`}
        >
          <span class="font-mono text-xs tracking-[0.18em] opacity-50">{`{0${i + 1}}`}</span>
          <h3
            class="font-display text-2xl font-extrabold uppercase leading-none transition-transform duration-300 group-hover:translate-x-2 md:text-3xl lg:text-5xl"
            style="font-stretch: 75%"
          >
            {s.name}
          </h3>
          <span class="hidden text-right font-mono text-xs uppercase tracking-[0.14em] opacity-40 transition-opacity duration-300 group-hover:opacity-100 md:block">
            {s.tags}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
