---
const services = [
  {
    number: "{01}",
    title: "UX / UI Design",
    tags: "Research · Prototipado · Sistemas de diseño",
  },
  {
    number: "{02}",
    title: "Frontend",
    tags: "React · Next.js · Astro · SPA",
  },
  {
    number: "{03}",
    title: "Backend",
    tags: "APIs · Microservicios · Bases de datos",
  },
  {
    number: "{04}",
    title: "Cloud / DevOps",
    tags: "AWS · CI/CD · Infraestructura como código",
  },
  {
    number: "{05}",
    title: "QA",
    tags: "Testing manual · Automatizado · E2E",
  },
  {
    number: "{06}",
    title: "Soporte",
    tags: "Monitoreo · Mantenimiento · Iteración",
  },
];
---
<section id="servicios" class="py-32 bg-black">
  <div class="max-w-[1400px] mx-auto px-10">
    <div class="grid grid-cols-2 gap-10">
      <div>
        <p class="font-mono text-xs tracking-[2.16px] uppercase text-white/50">— Servicios</p>
        <h2 class="font-archivo font-black text-[60px] leading-[60px] uppercase text-white mt-4">
          Un equipo,<br />todo el ciclo
        </h2>
      </div>
      <div class="flex items-end">
        <p class="font-inter text-lg text-white/60 leading-[29.25px]">
          No derivamos, no subcontratamos. Cada capa del producto — de la investigación a la infraestructura — vive dentro del mismo estudio.
        </p>
      </div>
    </div>
    <div class="mt-16 border-t border-white/15">
      {services.map((service) => (
        <div class="border-b border-white/15 py-8 grid grid-cols-[40px_1fr_auto] items-center gap-6">
          <span class="font-mono text-xs tracking-[2.16px] text-white/50">{service.number}</span>
          <h3 class="font-archivo font-extrabold text-[48px] leading-[48px] uppercase text-white">{service.title}</h3>
          <span class="font-mono text-xs tracking-[1.68px] uppercase text-white/40">{service.tags}</span>
        </div>
      ))}
    </div>
  </div>
</section>
