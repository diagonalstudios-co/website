---
---
<section id="contacto" class="py-32 bg-black">
  <div class="max-w-[1400px] mx-auto px-10">
    <div class="grid grid-cols-2 gap-16">
      <div>
        <p class="font-mono text-xs tracking-[2.16px] uppercase text-white/50">— Contacto</p>
        <h2 class="font-archivo font-black text-[72px] leading-[61.2px] uppercase text-white mt-4">
          Empecemos<br />tu proyecto
        </h2>
        <p class="font-inter text-lg text-white/60 mt-8 max-w-[448px]">
          Contanos tu idea y te ayudamos a convertirla en realidad. Sin compromisos, solo una conversación honesta.
        </p>
      </div>
      <div>
        <form class="space-y-6">
          <div class="grid grid-cols-2 gap-6">
            <div>
              <label for="name" class="block font-mono text-xs tracking-[2.16px] uppercase text-white/50 mb-3">Nombre</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full bg-transparent border-b border-white/20 pb-3 font-inter text-white placeholder-white/30 focus:outline-none focus:border-white/60 transition-colors"
                placeholder="Tu nombre"
              />
            </div>
            <div>
              <label for="email" class="block font-mono text-xs tracking-[2.16px] uppercase text-white/50 mb-3">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full bg-transparent border-b border-white/20 pb-3 font-inter text-white placeholder-white/30 focus:outline-none focus:border-white/60 transition-colors"
                placeholder="tu@email.com"
              />
            </div>
          </div>
          <div>
            <label for="project" class="block font-mono text-xs tracking-[2.16px] uppercase text-white/50 mb-3">Tipo de proyecto</label>
            <select
              id="project"
              name="project"
              class="w-full bg-transparent border-b border-white/20 pb-3 font-inter text-white focus:outline-none focus:border-white/60 transition-colors appearance-none"
            >
              <option value="" class="bg-black">Seleccioná una opción</option>
              <option value="web" class="bg-black">Sitio web</option>
              <option value="app" class="bg-black">Aplicación web</option>
              <option value="mobile" class="bg-black">App móvil</option>
              <option value="saas" class="bg-black">Producto SaaS</option>
              <option value="other" class="bg-black">Otro</option>
            </select>
          </div>
          <div>
            <label for="message" class="block font-mono text-xs tracking-[2.16px] uppercase text-white/50 mb-3">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="w-full bg-transparent border-b border-white/20 pb-3 font-inter text-white placeholder-white/30 focus:outline-none focus:border-white/60 transition-colors resize-none"
              placeholder="Contanos sobre tu proyecto..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full mt-8 px-8 py-4 bg-white text-black font-mono text-xs tracking-[2.16px] uppercase hover:bg-white/90 transition-colors cursor-pointer"
          >
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
