---
import NodeNetwork from "./svg/NodeNetwork.astro";
---
<section id="contacto" class="relative overflow-hidden bg-ink text-paper py-24 md:py-32">
  <NodeNetwork class="pointer-events-none absolute -left-32 -top-24 h-[120%] w-[60%] opacity-30" rings={false} />
  <div class="relative mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="grid gap-16 md:grid-cols-[1fr_1fr]">
      <div class="reveal">
        <p class="mb-6 font-mono text-xs uppercase tracking-[0.18em] text-paper/50">— Contacto</p>
        <h2 class="font-display text-4xl font-black uppercase leading-[0.85] md:text-5xl lg:text-8xl" style="font-stretch: 75%">
          Empecemos<br />tu proyecto
        </h2>
        <p class="mt-8 max-w-md text-base text-paper/60 md:text-lg">
          Contanos qué querés construir. Respondemos en menos de 24 horas con próximos pasos concretos.
        </p>
        <div class="mt-10 space-y-1 font-mono text-sm uppercase tracking-[0.12em] text-paper/70">
          <p>diagonalstudios.co@gmail.com</p>
          <p>Buenos Aires</p>
        </div>
      </div>

      <form id="contact-form" action="/api/contact" method="post" class="reveal flex flex-col gap-8" style="animation-delay: 0.12s">
        <label class="group block">
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-paper/50">Nombre</span>
          <input
            required
            type="text"
            name="name"
            placeholder="Cómo te llamás"
            class="mt-3 w-full border-b border-paper/25 bg-transparent pb-3 text-base text-paper placeholder:text-paper/30 outline-none transition-colors focus:border-paper md:text-lg"
          />
        </label>
        <label class="group block">
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-paper/50">Email</span>
          <input
            required
            type="email"
            name="email"
            placeholder="tu@empresa.com"
            class="mt-3 w-full border-b border-paper/25 bg-transparent pb-3 text-base text-paper placeholder:text-paper/30 outline-none transition-colors focus:border-paper md:text-lg"
          />
        </label>
        <label class="block">
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-paper/50">Mensaje</span>
          <textarea
            required
            rows="3"
            name="message"
            placeholder="Contanos sobre tu producto"
            class="mt-3 w-full resize-none border-b border-paper/25 bg-transparent pb-3 text-base text-paper placeholder:text-paper/30 outline-none transition-colors focus:border-paper md:text-lg"
          ></textarea>
        </label>

        <button
          type="submit"
          id="submit-btn"
          class="group inline-flex items-center justify-center gap-3 bg-paper px-7 py-4 font-mono text-sm uppercase tracking-[0.15em] text-ink transition-transform duration-300 hover:-translate-y-0.5 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span id="btn-text">Enviar mensaje</span>
          <span id="btn-arrow" class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">↗</span>
        </button>
        <p id="form-message" class="font-mono text-sm uppercase tracking-[0.14em] hidden"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text")!;
  const btnArrow = document.getElementById("btn-arrow")!;
  const formMessage = document.getElementById("form-message")!;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const name = formData.get("name") as string;
    const email = formData.get("email") as string;
    const message = formData.get("message") as string;

    btn.disabled = true;
    btnText.textContent = "Enviando...";
    btnArrow.classList.add("hidden");
    formMessage.classList.add("hidden");

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, message }),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        formMessage.textContent = "Mensaje enviado — te escribimos pronto";
        formMessage.classList.remove("hidden", "text-red-400");
        formMessage.classList.add("text-emerald-400");
        form.reset();
      } else {
        formMessage.textContent = data.error || "Error al enviar el mensaje";
        formMessage.classList.remove("hidden", "text-emerald-400");
        formMessage.classList.add("text-red-400");
      }
    } catch {
      formMessage.textContent = "Error de conexión — intentá de nuevo";
      formMessage.classList.remove("hidden", "text-emerald-400");
      formMessage.classList.add("text-red-400");
    } finally {
      btn.disabled = false;
      btnText.textContent = "Enviar mensaje";
      btnArrow.classList.remove("hidden");
    }
  });
</script>
