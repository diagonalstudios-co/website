---
const STAGES = [
  { n: "01", name: "Diseño", desc: "Investigación, UX y una interfaz que ya se ve como el producto final." },
  { n: "02", name: "Desarrollo", desc: "Frontend y backend construidos por el mismo equipo que lo diseñó." },
  { n: "03", name: "Implementación", desc: "Infraestructura, despliegue y puesta en producción sin traspasos." },
  { n: "04", name: "Soporte", desc: "Monitoreo, iteración y evolución continua después del lanzamiento." },
];
---
<section id="proceso" class="bg-paper py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="reveal mb-16 grid gap-6 md:grid-cols-[auto_1fr] md:items-end md:gap-16">
      <h2 class="font-display text-5xl font-black uppercase leading-[0.85] lg:text-7xl" style="font-stretch: 75%">
        Cómo<br />trabajamos
      </h2>
      <p class="max-w-md text-g-500 md:pb-3">
        Un solo flujo continuo. Cada etapa la ejecuta el mismo estudio, así el conocimiento nunca se pierde en un traspaso.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-0">
      {STAGES.map((s, i) => (
        <div
          class="reveal group relative border-t border-g-300 py-8 md:border-t-0 md:border-l md:py-0 md:pl-6 md:pr-4 first:border-l-0 lg:first:border-l"
          style={`animation-delay: ${i * 0.08}s`}
        >
          <span class="absolute -top-[5px] left-0 hidden h-[9px] w-[9px] -translate-x-1/2 bg-ink transition-transform duration-500 group-hover:scale-150 lg:block" />
          <div class="lg:min-h-[320px] lg:pt-8">
            <span class="font-display text-5xl font-black leading-none text-g-200 transition-colors duration-500 group-hover:text-ink md:text-6xl lg:text-8xl" style="font-stretch: 75%">
              {s.n}
            </span>
            <h3 class="mt-4 font-display text-xl font-extrabold uppercase break-words md:text-2xl lg:text-[1.65rem] lg:leading-tight" style="font-stretch: 75%">
              {s.name}
            </h3>
            <p class="mt-3 max-w-[240px] text-sm leading-relaxed text-g-500">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
