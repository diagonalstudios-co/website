---
import logoUrl from "./svg/logo.svg";

const NAV = [
  { label: "Home", href: "#top" },
  { label: "Proceso", href: "#proceso" },
  { label: "Casos de éxito", href: "#casos" },
  { label: "Contacto", href: "#contacto" },
];
---
<header class="fixed inset-x-0 top-0 z-50 transition-colors duration-500 bg-ink/95 text-paper backdrop-blur" id="navbar">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-6 py-4 md:px-10">
    <a href="#top" class="group flex items-center gap-3">
      <img src={logoUrl} alt="" class="h-7 w-auto transition-transform duration-500 group-hover:rotate-6" />
      <span class="font-display text-lg font-extrabold tracking-tight" style="font-stretch: 75%">
        DIAGONAL <span class="font-medium text-current/70">STUDIOS</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {NAV.map((item) => (
        <a
          href={item.href}
          class="font-mono text-xs uppercase tracking-[0.18em] opacity-70 transition-opacity hover:opacity-100"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href="#contacto"
      class="group inline-flex items-center gap-2 border border-current px-4 py-2 font-mono text-xs uppercase tracking-[0.18em] transition-colors hover:bg-paper hover:text-ink"
    >
      Contacto
      <span class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">↗</span>
    </a>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  if (navbar) {
    const onScroll = () => {
      if (window.scrollY > 24) {
        navbar.classList.add("bg-ink/95", "text-paper", "backdrop-blur");
        navbar.classList.remove("bg-transparent");
      } else {
        navbar.classList.remove("bg-ink/95", "backdrop-blur");
        navbar.classList.add("bg-transparent", "text-paper");
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
