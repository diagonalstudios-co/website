---
import { Image } from "astro:assets";
import ramiroImg from "./images/Ramiro Gil.jpeg";
import francoImg from "./images/Franco Arce.jpeg";

const TEAM = [
  { name: "Ramiro Gil", role: "Product Engineer", img: ramiroImg },
  { name: "Franco Arce", role: "Product Engineer", img: francoImg },
];
---
<section class="border-t border-g-200 bg-paper py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="reveal mb-16 grid gap-6 md:grid-cols-[1fr_1fr] md:gap-16">
      <h2 class="font-display text-3xl font-black uppercase leading-none md:text-4xl lg:text-6xl" style="font-stretch: 75%">
        El estudio<br />completo
      </h2>
      <p class="self-end text-g-500">
        Una misma visión para todo el producto. Integramos diseño e ingeniería desde el primer concepto hasta la implementación, cuidando cada decisión y acompañando su evolución.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-px bg-g-200 md:grid-cols-2 lg:grid-cols-4">
      {TEAM.map((m, i) => (
        <figure
          class="reveal group bg-paper"
          style={`animation-delay: ${i * 0.08}s`}
        >
          <div class="relative aspect-[3/4] overflow-hidden bg-g-200">
            <Image
              src={m.img}
              alt={`${m.name} — ${m.role} en Diagonal Studios`}
              format="webp"
              loading="lazy"
              class="h-full w-full object-cover grayscale contrast-110 transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
            />
          </div>
          <figcaption class="flex items-baseline justify-between gap-2 p-4">
            <span class="font-display text-sm font-extrabold uppercase md:text-base" style="font-stretch: 75%">
              {m.name}
            </span>
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-g-500">{m.role}</span>
          </figcaption>
        </figure>
      ))}
      <div class="hidden bg-paper lg:col-span-2 lg:block" aria-hidden="true"></div>
    </div>
  </div>
</section>
