---
const NAV = [
  { label: "Home", href: "#top" },
  { label: "Proceso", href: "#proceso" },
  { label: "Casos de éxito", href: "#casos" },
  { label: "Contacto", href: "#contacto" },
];
---
<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="grid gap-12 border-t border-paper/15 py-16 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <a href="#top" class="flex items-center gap-3">
          <svg width="100" height="107" viewBox="0 0 100 107" fill="none" class="h-8 w-auto" aria-hidden="true">
            <path d="M0 5.95529V91.8677L49.4152 40.8084H33.7232V28.4097H71.6374V66.6797H58.7719V50.5712L3.60624 107H50.5848C89.5712 103.017 99.7726 70.1293 100 54.1834C99.7661 14.4294 68.1287 1.49696 52.3392 0H5.16569C1.03314 0.859124 0 4.32816 0 5.95529Z" fill="white"/>
          </svg>
          <span class="font-display text-xl font-extrabold" style="font-stretch: 75%">
            DIAGONAL STUDIOS
          </span>
        </a>
        <p class="mt-6 max-w-sm text-paper/50">
          Estudio integral de software. Diseño, desarrollo e implementación — tu producto de punta a punta, sin intermediarios.
        </p>
      </div>

      <div>
        <p class="mb-5 font-mono text-xs uppercase tracking-[0.18em] text-paper/40">Navegación</p>
        <ul class="space-y-3">
          {NAV.map((n) => (
            <li>
              <a href={n.href} class="text-paper/70 transition-colors hover:text-paper">
                {n.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="mb-5 font-mono text-xs uppercase tracking-[0.18em] text-paper/40">Redes</p>
        <ul class="space-y-3">
          {["Instagram", "LinkedIn"].map((s) => (
            <li>
              <a href="#" class="group inline-flex items-center gap-2 text-paper/70 transition-colors hover:text-paper">
                {s}
                <span class="opacity-0 transition-all group-hover:translate-x-1 group-hover:opacity-100">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-paper/15 py-8 font-mono text-xs uppercase tracking-[0.14em] text-paper/40 md:flex-row md:items-center md:justify-between">
      <span>© 2026 Diagonal Studios</span>
      <span>diagonalstudios.co@gmail.com</span>
      <span>Buenos Aires</span>
    </div>
  </div>
</footer>
