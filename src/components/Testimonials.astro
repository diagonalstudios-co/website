---
const TESTIMONIALS = [
  {
    quote: "Contratamos un equipo, no cinco proveedores. Diseño, desarrollo e infraestructura hablaban el mismo idioma desde el día uno.",
    name: "Lucía Ferrer",
    role: "COO, Atlas·Pay",
  },
  {
    quote: "Pasamos de una idea en una servilleta a un MVP en producción en ocho semanas. Sin intermediarios, sin teléfono descompuesto.",
    name: "Martín Deza",
    role: "Fundador, Kuiper",
  },
];
---
<section class="bg-paper py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <p class="reveal mb-14 font-mono text-xs uppercase tracking-[0.18em] text-g-500">— En sus palabras</p>
    <div class="grid gap-px bg-g-200 md:grid-cols-2">
      {TESTIMONIALS.map((t, i) => (
        <blockquote
          class="reveal relative bg-paper p-8 md:p-12"
          style={`animation-delay: ${i * 0.12}s`}
        >
          <span class="font-display text-7xl font-black leading-none text-g-200 md:text-8xl" style="font-stretch: 75%">
            &ldquo;
          </span>
          <p class="-mt-6 font-display text-2xl font-semibold leading-tight md:text-3xl" style="font-stretch: 85%">
            {t.quote}
          </p>
          <footer class="mt-8 flex items-center gap-4 border-t border-g-200 pt-5">
            <span class="font-display text-lg font-extrabold uppercase" style="font-stretch: 75%">
              {t.name}
            </span>
            <span class="font-mono text-xs uppercase tracking-[0.14em] text-g-500">{t.role}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
