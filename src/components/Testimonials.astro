---
const testimonials = [
  {
    quote: "Contrataron a Diagonal para implementar una plataforma de trading que mejorara el rendimiento y la escalabilidad de nuestro sistema actual. El equipo no solo cumplió con las expectativas, sino que superó cada hito del proyecto con una ejecución impecable.",
    author: "Lucas Garay",
    role: "CEO, Atlas·Pay",
  },
  {
    quote: "Diagonal transformó nuestra visión en un producto que superó nuestras expectativas. Su enfoque integral y atención al detalle marcaron la diferencia.",
    author: "Sofía Martínez",
    role: "CTO, Kuiper",
  },
  {
    quote: "El equipo de Diagonal no solo desarrolló nuestro sistema, sino que nos asesoró en cada decisión técnica. Son un socio estratégico de verdad.",
    author: "Martín López",
    role: "Director de TI, Meridian",
  },
];
---
<section class="py-32 border-t border-[#e6e6e6]">
  <div class="max-w-[1400px] mx-auto px-10">
    <div class="grid grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <blockquote class="flex flex-col">
          <p class="font-inter text-base text-[#333] leading-[28px] flex-1">
            "{t.quote}"
          </p>
          <footer class="mt-8 pt-6 border-t border-[#e6e6e6]">
            <p class="font-inter font-medium text-sm text-black">{t.author}</p>
            <p class="font-inter text-sm text-[#666]">{t.role}</p>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
