---
const TESTIMONIALS = [
  {
    quote: "Antes teníamos todo nuestro catálogo en un PDF y era bastante difícil mostrar todo lo que ofrecemos. Ahora nuestros clientes pueden recorrer los productos, conocer las marcas y encontrar lo que buscan desde la web.",
    name: "Manuel Balihaut",
    role: "Co-founder, Elix",
  },
  {
    quote: "La verdad que trabajar con ellos fue súper simple. Les contamos la idea que teníamos y fueron armando todo con nosotros hasta llegar a una web que nos encanta.",
    name: "Genaro Lazzaro",
    role: "Co-founder, Elix",
  },
];
---
<section class="bg-paper py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <h2 class="reveal mb-14 font-mono text-xs uppercase tracking-[0.18em] text-g-500">— En sus palabras</h2>
    <div class="grid gap-px bg-g-200 md:grid-cols-2">
      {TESTIMONIALS.map((t, i) => (
        <blockquote
          class="reveal relative bg-paper p-8 md:p-12"
          style={`animation-delay: ${i * 0.12}s`}
        >
          <span class="font-display text-6xl font-black leading-none text-g-200 md:text-7xl lg:text-8xl" style="font-stretch: 75%">
            &ldquo;
          </span>
          <p class="-mt-4 font-display text-xl font-semibold leading-tight md:-mt-6 md:text-2xl lg:text-3xl" style="font-stretch: 85%">
            {t.quote}
          </p>
          <footer class="mt-8 flex flex-wrap items-center gap-4 border-t border-g-200 pt-5">
            <span class="font-display text-base font-extrabold uppercase lg:text-lg" style="font-stretch: 75%">
              {t.name}
            </span>
            <span class="font-mono text-xs uppercase tracking-[0.14em] text-g-500">{t.role}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
